# 仅供说明；应用不会自动读取此文件。请在启动终端中设置环境变量。
JAVA_PORT=18080
PYTHON_PORT=18081
JAVA_URL=http://127.0.0.1:18080
PYTHON_URL=http://127.0.0.1:18081
DEMO_BUSINESS_DATE=2026-10-20
# 本机合成演示缺省值已写入代码。使用其他值时，两服务的 service key 必须一致。
DEMO_SERVICE_KEY=replace-with-a-local-service-key
DEMO_JWT_SECRET=replace-with-at-least-32-bytes-of-random-local-secret
# 可选真实模型；未设置时固定查询仍可用，开放式问题明确降级。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
